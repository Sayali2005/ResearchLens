# ResearchLens Configuration

# App Metadata
APP_NAME="ResearchLens AI"
APP_VERSION="1.0.0"

# Scholarly APIs
# OpenAlex API Key (Free registration at https://openalex.org)
OPENALEX_API_KEY=""
OPENALEX_BASE_URL="https://api.openalex.org"

# Semantic Scholar API Key & URL (Free registration at https://www.semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=""
SEMANTIC_SCHOLAR_API_URL="https://api.semanticscholar.org/graph/v1"

# Contact email for politeness pool (OpenAlex, Crossref, Unpaywall)
CONTACT_EMAIL="researcher@example.com"

# Database (MongoDB connection string, local or MongoDB Atlas)
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/researchlens?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="researchlens"

# Frontend Allowed Origin (for CORS)
FRONTEND_URL="http://localhost:5173"

# Cache TTL Configuration
CACHE_TTL_COUNTS_DAYS=7
CACHE_TTL_PAPERS_HOURS=24

# Development Mock Flag (true allows mock data for offline local dev; false enforces live APIs)
DEV_MOCK=false
